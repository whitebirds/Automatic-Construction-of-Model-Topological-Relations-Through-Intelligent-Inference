{
  "purpose": "Manually transcribed public paper settings; not an exported private protocol or a synthetic-demo configuration",
  "private_data_or_artifacts_included": false,
  "split": {
    "unit": "physical_station",
    "evaluation_folds": 5,
    "fit_preprocessing_on": "training_only",
    "select_parameters_on": "validation_only",
    "reserved_partition_used_by_reported_main_methods": false,
    "exact_private_membership_included": false
  },
  "feature_type_vocabulary": ["407", "408", "409", "410", "411", "415", "416", "421", "463", "515"],
  "initial_mlp": {
    "hidden_widths": [48, 24],
    "epochs": 24,
    "batch_size": 512,
    "learning_rate": 0.001,
    "negative_to_positive_sample_ratio": 5,
    "name_weight_candidates": [0.0, 0.25, 0.5, 1.0, 2.0],
    "epoch_selection": "validation_full_graph_f1",
    "decision_threshold": "selected_from_validation_scores"
  },
  "ecpn": {
    "equipment_width": 16,
    "decoder_hidden_widths": [32, 16],
    "hierarchical_epochs": 36,
    "hierarchical_learning_rate": 0.001,
    "character_epochs": 24,
    "character_learning_rate": 0.0001,
    "character_embedding_dimension": 8,
    "convolution_widths": [2, 3, 4],
    "convolution_channels_per_width": 8,
    "combined_name_code_feature_dimension": 48,
    "encoded_name_max_length_including_boundaries": 64,
    "encoded_code_max_length_including_boundaries": 32,
    "candidate_auxiliary_loss_weight": 0.15,
    "degree_auxiliary_loss_weight": 0.02,
    "degree_target_transform": "log1p(n) / 3",
    "initialization_offsets": [0, 1000],
    "main_initialization_offset": 0,
    "initial_mlp_frozen": true,
    "main_character_channels": "name_and_code"
  },
  "bcpn": {
    "mode": "independent",
    "ensemble_members": 2,
    "probability_aggregation": "equal_mean_after_each_member_softmax",
    "equipment_width": 32,
    "scoring_hidden_width": 48,
    "epochs": 40,
    "learning_rate": 0.0003,
    "initialization_offsets": [0, 1000],
    "ambiguous_device_loss_weight": 4.0,
    "other_device_loss_weight": 1.0,
    "candidate_set": "voltage_compatible_busbars_plus_no_direct_busbar",
    "validation_priority": ["ambiguous_device_error_rate", "all_device_error_rate", "candidate_cross_entropy"],
    "tied_maximum": "no_direct_busbar"
  },
  "hrm": {
    "reference_stations": 8,
    "reference_devices_per_station_before_retaining_cutoff_ties": 8,
    "fixed_equipment_projection_dimension": 8,
    "fixed_projection_seed": 217,
    "scoring_hidden_width": 16,
    "epochs": 25,
    "validation_epoch_interval": 5,
    "learning_rate": 0.001,
    "optimizer": "Adam",
    "initialization_settings": [7, 19],
    "fold_initialization": "setting + 100 * zero_based_fold_index",
    "main_initialization_setting": 19,
    "reference_branch_loss_weight_main": 0.5,
    "reference_branch_loss_weight_ablation": 0.0,
    "fusion_candidates": [0.0, 0.1, 0.3, 0.5, 0.7, 1.0],
    "validation_priority": ["ambiguous_device_error_count", "all_device_error_count", "smaller_fusion_weight", "earlier_epoch"],
    "main_features": "attributes_and_local_structure",
    "query_structure": "initial_mlp_predicted_continuous_weights",
    "reference_structure": "known_training_connections",
    "query_physical_station_excluded_from_reference_pool": true,
    "earlier_encoders_fixed": true
  },
  "xgboost": {
    "connection_objective": "binary:logistic",
    "candidate_ranker_objective": "rank:pairwise",
    "tree_method": "hist",
    "depth_candidates": [3, 6, 9],
    "round_candidates": [40, 80, 160, 240],
    "learning_rate": 0.05,
    "subsample": 0.9,
    "colsample_bytree": 0.9,
    "negative_to_positive_sample_ratio_connection_model": 5,
    "initialization_settings": [7, 19],
    "main_initialization_setting": 7
  },
  "dh_r": {
    "reference_stations": 1,
    "neural_predictor_used": false,
    "role_constraints": true,
    "purpose": "adapted_direct_historical_relation_transfer"
  }
}
